# --- Server ---
PORT=4000
# Directory containing the built frontend (vite build output). Leave unset to
# run the API only (useful during frontend dev with the Vite dev server).
STATIC_DIR=../frontend/dist

# --- Auth ---
# Single-user login. Generate the hash with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
APP_USERNAME=admin
APP_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
APP_JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- Target server (the machine to wake/shutdown/monitor) ---
TARGET_HOST=192.168.1.50
TARGET_MAC_ADDRESS=AA:BB:CC:DD:EE:FF
# Broadcast address of the LAN segment the target's NIC is on.
TARGET_BROADCAST_ADDRESS=192.168.1.255
TARGET_WOL_PORT=9

TARGET_SSH_PORT=22
TARGET_SSH_USER=pi-remote
TARGET_SSH_PRIVATE_KEY_PATH=/home/pi/.ssh/id_ed25519_server

# Absolute path to remote-stats.sh once copied onto the target server.
# See backend/deploy/remote-stats.sh
STATS_SCRIPT_PATH=/usr/local/bin/server-app-stats.sh
# Space-separated mount points to report disk usage for.
STATS_DISK_PATHS=/
